      "name": "00 Mail prerequisites",
      "item": [
        {
          "name": "R1-MAIL-SETUP-001 | Login super",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expected = 200;",
                  "let passed = true;",
                  "function check(name, fn) { pm.test(name, () => { try { fn(); } catch(e) { passed=false; throw e; } }); }",
                  "check(\"R1-MAIL-SETUP-001: HTTP \" + expected, () => pm.expect(pm.response.code).to.eql(expected));",
                  "let data; try { data = pm.response.json(); } catch (_) {}",
                  "check(\"No server error\", () => pm.expect(pm.response.code).to.be.below(500));",
                  "check(\"Response contract\", () => { pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(data.user.role).to.be.a(\"string\"); });",
                  "if (pm.response.code === expected) pm.collectionVariables.set(\"superToken\", data.accessToken);",
                  "const report = JSON.parse(pm.collectionVariables.get(\"run_results\") || \"[]\"); report.push({id:\"R1-MAIL-SETUP-001\",name:\"Login super\",expected,actual:pm.response.code,result:passed?\"PASS\":\"FAIL\"}); pm.collectionVariables.set(\"run_results\",JSON.stringify(report));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/login",
            "description": "Login super",
            "auth": {
              "type": "noauth"
            },
