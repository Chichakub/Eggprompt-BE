              "mode": "raw",
              "raw": "{\n  \"username\": \"{{superUsername}}\",\n  \"password\": \"{{superPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
