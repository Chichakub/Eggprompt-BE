  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const c = pm.collectionVariables;",
          "if (pm.info.requestName.startsWith(\"R1-SETUP-001\")) {",
          " c.set(\"runId\", String(Date.now()).slice(-9)); c.set(\"run_results\", \"[]\");",
          " [\"superToken\",\"adminToken\",\"staffToken\",\"financeToken\",\"otherToken\",\"houseId\",\"emptyHouseId\",\"flockId\",\"eggId\",\"newUserId\",\"newFinanceId\"].forEach(k=>c.unset(k));",
          "}",
          "if (!c.get(\"runId\")) c.set(\"runId\",String(Date.now()).slice(-9));",
          "const parts = Object.fromEntries(new Intl.DateTimeFormat(\"en-CA\",{timeZone:\"Asia/Bangkok\",year:\"numeric\",month:\"2-digit\",day:\"2-digit\"}).formatToParts(new Date()).map(p=>[p.type,p.value]));",
          "const day = `${parts.year}-${parts.month}-${parts.day}`;",
          "c.set(\"today\",day);",
          "c.set(\"receivedDate\",new Date(Date.parse(day+\"T00:00:00Z\")-7*86400000).toISOString().slice(0,10));",
          "",
          "const received = c.get(\"receivedDate\");",
          "c.set(\"beforeReceivedDate\",new Date(Date.parse(received+\"T00:00:00Z\")-86400000).toISOString().slice(0,10));",
          "c.set(\"tomorrow\",new Date(Date.parse(c.get(\"today\")+\"T00:00:00Z\")+86400000).toISOString().slice(0,10));"
        ]
      }
    }
  ],
