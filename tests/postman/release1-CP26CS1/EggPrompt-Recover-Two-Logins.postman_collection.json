{
  "info": {
    "name": "EggPrompt - Recover Login other and Login password",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Move these two requests into the existing RUN ALL collection, folder 01 Setup accounts and data, after Login staff and before Read Hy-Line Brown breed. Run inside the original collection so its variables and saved tokens are used."
  },
  "item": [
    {
      "name": "R1-SETUP-004 | Login other",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expected = 200;",
              "let passed = true;",
              "function check(name, fn) { pm.test(name, () => { try { fn(); } catch(e) { passed=false; throw e; } }); }",
              "check(\"R1-SETUP-004: HTTP \" + expected, () => pm.expect(pm.response.code).to.eql(expected));",
              "let data; try { data = pm.response.json(); } catch (_) {}",
              "check(\"No server error\", () => pm.expect(pm.response.code).to.be.below(500));",
              "check(\"Response contract\", () => { pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(data.user.role).to.be.a(\"string\"); });",
              "if (pm.response.code === expected) pm.collectionVariables.set(\"otherToken\", data.accessToken);",
              "const report = JSON.parse(pm.collectionVariables.get(\"run_results\") || \"[]\"); report.push({id:\"R1-SETUP-004\",name:\"Login other\",expected,actual:pm.response.code,result:passed?\"PASS\":\"FAIL\"}); pm.collectionVariables.set(\"run_results\",JSON.stringify(report));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/auth/login",
        "description": "Login other",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{otherAdminUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "R1-SETUP-005 | Login password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expected = 200;",
              "let passed = true;",
              "function check(name, fn) { pm.test(name, () => { try { fn(); } catch(e) { passed=false; throw e; } }); }",
              "check(\"R1-SETUP-005: HTTP \" + expected, () => pm.expect(pm.response.code).to.eql(expected));",
              "let data; try { data = pm.response.json(); } catch (_) {}",
              "check(\"No server error\", () => pm.expect(pm.response.code).to.be.below(500));",
              "check(\"Response contract\", () => { pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(data.user.role).to.be.a(\"string\"); });",
              "if (pm.response.code === expected) pm.collectionVariables.set(\"passwordToken\", data.accessToken);",
              "const report = JSON.parse(pm.collectionVariables.get(\"run_results\") || \"[]\"); report.push({id:\"R1-SETUP-005\",name:\"Login password\",expected,actual:pm.response.code,result:passed?\"PASS\":\"FAIL\"}); pm.collectionVariables.set(\"run_results\",JSON.stringify(report));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/auth/login",
        "description": "Login password",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"pm.r1.password\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}
